# Flask Configuration
FLASK_APP=app.py
FLASK_DEBUG=True

# Security Keys (Ganti dengan string random yang aman di production)
SECRET_KEY=dev-secret-key-change-in-prod
JWT_SECRET_KEY=jwt-secret-key-change-in-production!!

# Database Configuration
# Format untuk PostgreSQL: postgresql://username:password@localhost:5432/database_name
# Format untuk SQLite lokal: sqlite:///eversnap.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eversnap

# Base URL (Digunakan untuk link di dalam QR Code)
BASE_URL=http://localhost:5000

# Redis Cache Configuration
# Format: redis://localhost:6379/<db_number>
# Gunakan db 0 untuk development, sesuaikan di production
REDIS_URL=redis://localhost:6379/0
# TTL cache event dalam detik (default 1 jam = 3600)
REDIS_EVENT_CACHE_TTL=3600
